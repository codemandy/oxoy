---
// MainNav.astro - Main navigation component
---

<nav class="main-nav">
  <div class="nav-grid">
    <div class="logo">
      <a href="/" class="logo-link">OXOY</a>
    </div>
    <a href="/news" class="nav-item">news</a>
    <a href="/" class="nav-item works-link">works</a>
    <a href="/contact" class="nav-item">contact</a>
  </div>
</nav> 

<style>
  .main-nav {
    width: 100%;
  }
  
  .nav-grid {
    display: grid;
    grid-template-columns: 1fr repeat(3, auto) 1fr;
    gap: 2rem;
    padding: 0.3rem 0.3rem;
    align-items: center;
    min-height: 10px;
  }
  
  .logo {
    font-size: 11px;
    letter-spacing: 0.05em;
    grid-column: 1;
    background-color: rgba(0, 0, 0, 0.03);
    padding: 1.5rem 1.5rem;
  }
  
  .logo-link {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.25rem 0.5rem;
    transition: opacity 0.2s ease;
    font-size: 0.9em;
  }
  
  .logo-link:hover {
    opacity: 0.8;
  }
  
  .nav-item {
    text-decoration: none;
    color: #333;
    transition: color 0.2s ease;
    font-size: 0.9em;
    padding: 0.25rem 0;
  }
  
  .nav-item:hover {
    color: #000;
  }
  
  .works-link {
    grid-column: 3;
    position: relative;
  }
</style> 
