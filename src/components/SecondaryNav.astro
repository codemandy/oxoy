---
// SecondaryNav.astro - Secondary navigation component
---

<div class="secondary-nav-container">
  <div class="secondary-nav-grid">
    <!-- Start secondary nav items at the same grid position as "works" in main nav -->
    <nav class="secondary-nav">
      <a href="/scaling-day">
        <span>Scaling.day</span>
      </a>
      <a href="/adriennes">
        <span>Adriennes.site</span>
      </a>
      <a href="/emmancipattsionsfrugten">
        <span>Emancipa(t/ss)ionsfrugten.org</span>
      </a>
      <a href="/bombinabombast">
        <span>Bombinabombast.com</span>
      </a>
      <a href="/toraschultz">
        <span>Toraschultz.com</span>
      </a>
      <a href="/virtual-rehearsal">
        <span>Virtual Rehearsal Space</span>
      </a>
    </nav>
  </div>
</div>

<style>
  .secondary-nav-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
  }
  
  .secondary-nav-grid {
    display: grid;
    grid-template-columns: 1fr repeat(3, auto) 1fr;
    padding: 0 2rem;
  }
  
  .secondary-nav {
    grid-column: 3;
    display: flex;
    overflow-x: auto;
    padding: 0 2rem; /* Match MainNav padding */
    margin: 0;
    justify-content: space-between;
    width: 100%;
    scroll-behavior: smooth; /* Smooth scrolling */
    -ms-overflow-style: none;  /* Hide scrollbar in IE and Edge */
    scrollbar-width: none;  /* Hide scrollbar in Firefox */
  }
  
  /* Hide scrollbar in Webkit browsers */
  .secondary-nav::-webkit-scrollbar {
    display: none;
  }
  
  .secondary-nav a {
    text-decoration: none;
    color: #333;
    font-size: 11px;
    padding: 3px 8px; /* Increased padding for touch targets */
    display: inline-block;
    position: relative;
    white-space: nowrap;
    text-align: center;
    flex: 0 0 auto; /* Don't force equal width on mobile */
    border-bottom: 1px solid #eee;

  }

  .secondary-nav a:last-child {
  border-right: 1px solid #eee;
}

  
  .secondary-nav a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #333;
  }
  
  .secondary-nav a:hover {
    color: #000;
  }
  
  /* Mobile-specific styles */
  @media (max-width: 767px) {
    .secondary-nav-container {
      margin-left: 0;
      width: 100%;
      overflow-x: visible; /* Allow content to wrap */
    }
    
    .secondary-nav-grid {
      display: block; /* Simplify layout on mobile */
      padding: 0;
    }
    
    .secondary-nav {
      width: 100%;
      padding: 0.5rem 2rem; /* Keep consistent with desktop and MainNav */
      justify-content: flex-start;
      flex-wrap: wrap; /* Enable wrapping */
      border-bottom: 1px solid #eee;
      overflow-x: visible; /* Disable horizontal scrolling */
      gap: 4px; /* Add gap between wrapped items */
    }
    
    .secondary-nav a {
      padding: 8px 12px; /* Adjusted padding for wrapped layout */
      margin-right: 4px;
      margin-bottom: 0px; /* Add space between rows */
      flex: 0 0 auto; /* Allow natural width */
      border: 1px solid #eee; 
    }
    
    /* Remove the scroll indicator since we're wrapping now */
    .secondary-nav::after {
      display: none;
    }
  }
</style> 
