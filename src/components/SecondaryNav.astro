---
// SecondaryNav.astro - Secondary navigation component
// Get unique years from projects (hardcoded for example)
const years = [2025, 2024, 2023, 2022];

// Get all projects (you would replace this with your actual data source)
// This is just an example structure
const allProjects = [
  { id: 'scaling-day', title: 'Scaling.day', year: 2024 },
  { id: 'adriennes', title: 'Adriennes.site', year: 2024 },
  { id: 'emmancipattsionsfrugten', title: 'Emancipa(t/ss)ionsfrugten.org', year: 2023 },
  { id: 'bombinabombast', title: 'Bombinabombast.com', year: 2023 },
  { id: 'toraschultz', title: 'Toraschultz.com', year: 2022 },
  { id: 'virtual-rehearsal', title: 'Virtual Rehearsal Space', year: 2022 },
];
---

<div class="container2">
  <div class="secondary-nav-grid">
    <!-- Start secondary nav items at the same grid position as "works" in main nav -->
    <nav class="secondary-nav years-nav">
      {years.map(year => (
        <a href={`#${year}`} class="year-link" data-year={year}>
          <span>{year}</span>
        </a>
      ))}
    </nav>

    <!-- Projects nav (initially hidden, will be shown when a year is clicked) -->
    {years.map(year => (
      <nav class="secondary-nav projects-nav" data-year={year} style="display: none;">
        {allProjects
          .filter(project => project.year === year)
          .map(project => (
            <a href={`/${project.id}`} data-year={year}>
              <span>{project.title}</span>
            </a>
          ))
        }
      </nav>
    ))}
  </div>
</div>

<style>

  .secondary-nav-grid {
    display: grid;
    grid-template-columns: 225px repeat(3, auto) 1fr;
    /* padding: 0 2rem; */
  }
  
  .secondary-nav {
    grid-column: 3;
    display: flex;
    overflow-x: auto;
    justify-content: space-between;
    width: 100%;
    scroll-behavior: smooth; /* Smooth scrolling */
    -ms-overflow-style: none;  /* Hide scrollbar in IE and Edge */
    scrollbar-width: none;  /* Hide scrollbar in Firefox */
  }
  
  /* Hide scrollbar in Webkit browsers */
  .secondary-nav::-webkit-scrollbar {
    display: none;
  }
  
  .secondary-nav a {
    text-decoration: none;
    color: #333;
    padding: 3px 35px; /* Increased padding for touch targets */
    display: inline-block;
    position: relative;
    white-space: nowrap;
    text-align: center;
    flex: 0 0 auto; /* Don't force equal width on mobile */
    border-bottom: 1px solid #eee;
  }

  .secondary-nav a:last-child {
    border-right: 1px solid #eee;
  }
  
  .secondary-nav a.active::after,
  .secondary-nav a.active-year::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #333;
  }
  
  .secondary-nav a:hover {
    color: #000;
  }

  .back-to-years {
  display: inline-block;
  text-decoration: none;
  color: #333;
  font-size: 11px;
  padding: 3px 8px;
  margin-bottom: 10px;
  cursor: pointer;
  border: 1px solid #eee;
}

.back-to-years:hover {
  background-color: #f5f5f5;
}
  
  /* Mobile-specific styles */
  @media (max-width: 767px) {
    .secondary-nav-container {
      margin-left: 1.3rem;
      width: 100%;
      overflow-x: visible; /* Allow content to wrap */
    }
    
    .secondary-nav-grid {
      display: block; /* Simplify layout on mobile */
      padding: 0;
    }
    
    .secondary-nav {
      width: 100%;
      padding: 0.5rem 0rem; /* Keep consistent with desktop and MainNav */
      justify-content: flex-start;
      flex-wrap: wrap; /* Enable wrapping */
      border-bottom: 1px solid #eee;
      overflow-x: visible; /* Disable horizontal scrolling */
      gap: 4px; /* Add gap between wrapped items */
    }
    
    .secondary-nav a {
      padding: 8px 12px; /* Adjusted padding for wrapped layout */
      margin-right: 4px;
      margin-bottom: 0px; /* Add space between rows */
      flex: 0 0 auto; /* Allow natural width */
      border: 1px solid #eee; 
    }
    
    /* Remove the scroll indicator since we're wrapping now */
    .secondary-nav::after {
      display: none;
    }
  }


</style> 
