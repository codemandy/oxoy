---
// SecondaryNav.astro - Secondary navigation component
---

<div class="secondary-nav-container">
  <div class="secondary-nav-grid">
    <!-- Start secondary nav items at the same grid position as "works" in main nav -->
    <nav class="secondary-nav">
      <a href="/scaling-day">
        <span>Scaling.day</span>
      </a>
      <a href="/adriennes">
        <span>Adriennes.site</span>
      </a>
      <a href="/emmancipattsionsfrugten">
        <span>Emancipa(t/ss)ionsfrugten.org</span>
      </a>
      <a href="/bombinabombast">
        <span>Bombinabombast.com</span>
      </a>
      <a href="/toraschultz">
        <span>Toraschultz.com</span>
      </a>
      <a href="/virtual-rehearsal">
        <span>Virtual Rehearsal Space</span>
      </a>
    </nav>
  </div>
</div>

<style>
  .secondary-nav-container {
    width: 100%;
  }
  
  .secondary-nav-grid {
    display: grid;
    /* Match the exact same grid template as MainNav */
    grid-template-columns: 1fr repeat(3, auto) 1fr;
    padding: 0 2rem;
  }
  
  /* Ensure perfect alignment with the works link */
  .secondary-nav {
    grid-column: 3; /* Same column as works-link */
    display: flex;
    overflow-x: auto;
    padding: 0; /* Remove ALL padding */
    margin: 0; /* Remove ALL margin */
    justify-content: space-between; /* Distribute items evenly */
    width: 100%; /* Ensure it takes full width of the grid column */
  }
  
  .secondary-nav a {
    text-decoration: none;
    color: #333;
    font-size: 11px;
    padding-bottom: 8px;
    display: inline-block;
    position: relative;
    white-space: nowrap;
    text-align: center; /* Center text within each link */
    flex: 1; /* Make each link take equal space */
  }
  
  .secondary-nav a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #333;
  }
  
  .secondary-nav a:hover {
    color: #000;
  }
  
  /* Hide horizontal scrollbar but keep functionality */
  .secondary-nav::-webkit-scrollbar {
    height: 0;
    width: 0;
  }
</style> 
