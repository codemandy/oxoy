---
import Layout from '../layouts/Layout.astro';
import MainNav from '../components/MainNav.astro';

// Sample news items data
const newsItems = [
  {
    id: 1,
    title: "Bombina Bombast new website",
    date: "April 4, 2025",
    summary: "Website for the company Bombina Bombast",
    content: "WEBSITE, CMS, DESIGN, DEVELOPMENT",
    image: "/images/bb_01.png"
  },
  {
    id: 2,
    title: "Scaling.day",
    date: "March 28, 2023",
    summary: "Website for the event Scaling.day",
    content: "WEBSITE, CMS, DESIGN, DEVELOPMENT",
    image: "/images/scday_01.png"
  },
  {
    id: 3,
    title: "Adriennes.site",
    date: "March 28, 2023",
    summary: "Audio module for Adrienne Herr",
    content: "WEBSITE, CMS, DESIGN, DEVELOPMENT",
    image: "/images/adri_01.png"
  },
  {
    id: 4,
    title: "Virtual Rehearsal Space",
    date: "April 12, 2023",
    summary: "Website for the company Virtual Rehearsal Space",
    content: "WEBSITE, CMS, DESIGN, DEVELOPMENT",
    image: "/images/vrs_02.png"
  },
];
---

<Layout title="News - oxoy studio">
  <!-- Navigation outside container -->
  <MainNav />
  
  <!-- Content inside container -->
  <div class="container">
    
    <div class="news-grid">
      {newsItems.map((item) => (
        <article class="news-item">
          <div class="news-image-container">
            {item.image && (
              <img 
                src={item.image} 
                alt={`Image for ${item.title}`} 
                class="news-image"
                onerror="this.style.display='none'"
              />
            )}
          </div>
          <div class="news-content">
            <p class="news-date">{item.date}</p>
            <h2 class="news-title">{item.title}</h2>
            <p class="news-summary">{item.summary}</p>
            <div class="news-full-content">
              <p>{item.content}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>

  .news-item {
    margin: 48px 20 0px 10px;
    padding-top: 40px;
  }
  
 
  
 
  
  .news-grid {
    display: flex;
    flex-direction: column;
    gap: 48px;
    margin-bottom: 64px;
  }
  
  .news-item {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    border-bottom: 1px solid #eee;
    margin: ;
  }
  
  .news-image-container {
    width: 100%;
  }
  
  .news-image {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #f1f1f1;
  }
  
  .news-date {
    font-size: 13px;
    color: #666;
    margin-bottom: 8px;
  }
  
  .news-title {
    font-size: 18px;
    font-weight: normal;
    margin-bottom: 16px;
  }
  
  .news-summary {
    font-size: 14px;
    margin-bottom: 16px;
    line-height: 1.6;
  }
  
  .news-full-content {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }
  
  /* Responsive styles */
  @media (max-width: 767px) {
    /* Remove these container styles */
    /* .container {
      margin-left: 0;
      padding: 0 16px;
      width: 100%;
    } */

    .news-item {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    
    .news-image-container {
      margin-bottom: 16px;
    }
  }
</style>

<script>
  // Optional: Add JavaScript for interactive features
  document.addEventListener('DOMContentLoaded', () => {
    // Example: Add click handlers for news items
    const newsItems = document.querySelectorAll('.news-item');
    
    newsItems.forEach(item => {
      const title = item.querySelector('.news-title');
      const fullContent = item.querySelector('.news-full-content');
      
      // Initially hide the full content
      if (fullContent instanceof HTMLElement) {
        fullContent.style.display = 'none';
      }
      
      // Toggle content visibility on title click
      if (title && fullContent instanceof HTMLElement) {
        title.addEventListener('click', () => {
          fullContent.style.display = 
            fullContent.style.display === 'none' ? 'block' : 'none';
        });
        
        // Add cursor pointer to indicate clickable
        if (title instanceof HTMLElement) {
          title.style.cursor = 'pointer';
        }
      }
    });
  });
</script> 
